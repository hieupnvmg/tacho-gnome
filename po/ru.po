#: extension.js:48
msgid "Keep awake is on in Tacho"
msgstr "Tacho не даёт компьютеру уснуть"

#: extension.js:90
msgid "Tacho"
msgstr "Tacho"

#: extension.js:90
msgid "GNOME System Monitor is not installed."
msgstr "Системный монитор GNOME не установлен."

#: extension.js:160
#, javascript-format
msgid "Tacho %s is available"
msgstr "Доступен Tacho %s"

#: extension.js:161
msgid "Open the Tacho menu and choose “Update Tacho” to install it."
msgstr "Откройте меню Tacho и выберите «Обновить Tacho», чтобы установить."

#: extension.js:163
#, javascript-format
msgid "Tacho %s installed"
msgstr "Tacho %s установлен"

#: extension.js:164
msgid "Log out and back in to start using it."
msgstr "Выйдите и войдите снова, чтобы начать работу с новой версией."

#: extension.js:166
msgid "Tacho could not update"
msgstr "Tacho не удалось обновиться"

#: extension.js:263
msgid "VPN connected"
msgstr "VPN подключён"

#: extension.js:263
#, javascript-format
msgid "%s is up."
msgstr "%s включён."

#: extension.js:265
msgid "VPN disconnected"
msgstr "VPN отключён"

#: extension.js:265
#, javascript-format
msgid "%s went down."
msgstr "%s отключился."

#. Translators: e.g. "Claude Code: 82% of the 5h limit used".
#: extension.js:285
#, javascript-format
msgid "%s: %d%% of the %s limit used"
msgstr "%s: использовано %d%% лимита %s"

#: extension.js:287
msgid "Almost out. It resets on its own when the window ends."
msgstr "Лимит почти исчерпан. Он сбросится сам в конце окна."

#: extension.js:288
#, javascript-format
msgid "Past %d%%. Tacho will tell you again at 95%%."
msgstr "Больше %d%%. Tacho напомнит ещё раз на 95%%."

