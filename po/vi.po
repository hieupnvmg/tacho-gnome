#: extension.js:46
msgid "Keep awake is on in Tacho"
msgstr "Tacho đang giữ máy thức"

#: extension.js:88
msgid "Tacho"
msgstr "Tacho"

#: extension.js:88
msgid "GNOME System Monitor is not installed."
msgstr "Chưa cài GNOME System Monitor."

#: extension.js:158
#, javascript-format
msgid "Tacho %s is available"
msgstr "Đã có Tacho %s"

#: extension.js:159
msgid "Open the Tacho menu and choose “Update Tacho” to install it."
msgstr "Mở menu Tacho và chọn “Cập nhật Tacho” để cài."

#: extension.js:161
#, javascript-format
msgid "Tacho %s installed"
msgstr "Đã cài Tacho %s"

#: extension.js:162
msgid "Log out and back in to start using it."
msgstr "Đăng xuất rồi đăng nhập lại để dùng bản mới."

#: extension.js:164
msgid "Tacho could not update"
msgstr "Tacho không cập nhật được"

#: extension.js:258
msgid "VPN connected"
msgstr "VPN đã kết nối"

#: extension.js:258
#, javascript-format
msgid "%s is up."
msgstr "%s đã bật."

#: extension.js:260
msgid "VPN disconnected"
msgstr "VPN đã ngắt"

#: extension.js:260
#, javascript-format
msgid "%s went down."
msgstr "%s đã tắt."

#. Translators: e.g. "Claude Code: 82% of the 5h limit used".
#: extension.js:280
#, javascript-format
msgid "%s: %d%% of the %s limit used"
msgstr "%s: đã dùng %d%% hạn mức %s"

#: extension.js:282
msgid "Almost out. It resets on its own when the window ends."
msgstr "Sắp hết. Hạn mức tự đặt lại khi hết khung thời gian."

#: extension.js:283
#, javascript-format
msgid "Past %d%%. Tacho will tell you again at 95%%."
msgstr "Đã quá %d%%. Tacho sẽ báo lại khi tới 95%%."

