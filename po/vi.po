msgstr "Hỏi GitHub có bản mới mỗi 6 giờ và đưa vào menu"

#: prefs.js:81
msgid "Include pre-releases"
msgstr "Nhận cả bản pre-release"

#: prefs.js:86
msgid "Claude Code limits"
msgstr "Hạn mức Claude Code"

#: prefs.js:87
msgid ""
"Claude Code only reports its 5-hour and 7-day limits to a statusLine "
"command. Install the tacho-statusline script from the Tacho repository and "
"set it as the statusLine in ~/.claude/settings.json:"
msgstr "Claude Code chỉ báo hạn mức 5 giờ và 7 ngày cho lệnh statusLine. Cài script tacho-statusline từ repo Tacho và đặt nó làm statusLine trong ~/.claude/settings.json:"

